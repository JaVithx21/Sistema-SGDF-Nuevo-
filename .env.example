# Copiar a .env.local y completar. Nunca subir valores reales al repositorio.

# ─── Supabase (Project Settings → API) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (publishable / anon). Viaja al navegador; la protege RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor (src/lib/supabase/admin.ts). Salta RLS: no exponer jamás.
SUPABASE_SERVICE_ROLE_KEY=

# ─── URLs y orígenes ────────────────────────────────────────────────────────
# Base para el enlace de recuperación de contraseña (por defecto http://localhost:3000)
NEXT_PUBLIC_SITE_URL=
# Hosts permitidos en /auth/callback, separados por coma
ALLOWED_REDIRECT_HOSTS=
# Orígenes CORS permitidos para la API, separados por coma
ALLOWED_CORS_ORIGINS=

# ─── Integraciones ──────────────────────────────────────────────────────────
# OpenRouteService (geocodificación de clientes). Sin ella se guarda sin coordenadas.
ORS_API_KEY=
# Clave que debe enviar el chatbot para usar su endpoint
CHATBOT_API_KEY=
